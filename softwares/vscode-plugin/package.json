{
  "name": "bac-viewer",
  "displayName": "BAC Contribution Ledger",
  "description": "Explore BAC contribution timelines, Git ledger changes and related code diffs.",
  "version": "0.1.2",
  "publisher": "bensz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "bac",
    "audit",
    "contribution",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/huangwb8/bensz-auto-contribution",
    "directory": "softwares/vscode-plugin"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Local ledgers can be viewed. Git, file navigation and verification require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCustomEditor:bac.viewer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "bac.viewer",
        "displayName": "BAC Contribution Ledger",
        "selector": [
          {
            "filenamePattern": "*.bac"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "bacViewer.open",
        "title": "BAC: Open Contribution Ledger",
        "icon": "$(book)"
      },
      {
        "command": "bacViewer.compare",
        "title": "BAC: Compare Ledger with HEAD",
        "icon": "$(git-compare)"
      },
      {
        "command": "bacViewer.verify",
        "title": "BAC: Verify Ledger",
        "icon": "$(verified)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "bacViewer.open",
          "when": "resourceExtname == .bac",
          "group": "navigation"
        },
        {
          "command": "bacViewer.compare",
          "when": "resourceExtname == .bac",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "bacViewer.compare",
          "when": "activeCustomEditorId == bac.viewer",
          "group": "navigation"
        },
        {
          "command": "bacViewer.verify",
          "when": "activeCustomEditorId == bac.viewer",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "bacViewer.compare",
          "when": "resourceExtname == .bac",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "BAC Contribution Ledger",
      "properties": {
        "bacViewer.language": {
          "type": "string",
          "enum": [
            "en",
            "zh-CN"
          ],
          "enumDescriptions": [
            "English (default)",
            "简体中文（主动选择）"
          ],
          "default": "en",
          "scope": "application",
          "description": "Viewer language. Defaults to English regardless of the VS Code display language. Select Simplified Chinese here or in the viewer language menu."
        },
        "bacViewer.bacExecutable": {
          "type": "string",
          "default": "bac",
          "scope": "machine",
          "description": "Path to the BAC executable. Looked up in PATH or ~/.local/bin by default. Only required for full verification; viewing and Git comparison work without it.",
          "restricted": true
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node scripts/build.mjs",
    "test": "npm run compile && node --test dist/test/core.test.js",
    "test:vscode": "npm run compile && node scripts/test-vscode.mjs && node scripts/test-scm.mjs && node scripts/test-scm.mjs --untrusted",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/huangwb8/bensz-auto-contribution/blob/main/softwares/vscode-plugin --out dist/",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/yauzl": "^2.10.3",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0"
  }
}
