# BAC Anchor 部署配置。复制为 .env 后填入真实 secret；不要提交真实 .env。

BAC_ANCHOR_RELEASE_VERSION=1.3.2
BAC_ANCHOR_IMAGE_DIGEST=sha256:4ba278906812d406b16edf7b0d6e57a4c7aa172bafc8e65eda97c6390af9ec2c
BAC_ANCHOR_LOOPBACK_PORT=18080

POSTGRES_USER=bac_anchor
POSTGRES_PASSWORD=<generate-a-random-secret>
POSTGRES_DB=bac_anchor
PGDATA=/var/lib/postgresql/data

REDIS_DB=0

BAC_ANCHOR_KEY_ID=
BAC_ANCHOR_API_TOKEN=<generate-a-random-secret>
BAC_ANCHOR_ADMIN_TOKEN=<generate-a-random-secret>
BAC_ANCHOR_ENABLE_LEDGER_QUERY=false
BAC_ANCHOR_MAX_BODY_BYTES=8192
BAC_ANCHOR_RATE_LIMIT_PER_MINUTE=120
TZ=Asia/Shanghai
